{
  "name": "nolito",
  "version": "0.0.0",
  "private": true,
  "description": "NOLITO 個人開発プロダクトポータルサイト",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:html": "html-validate \"public/**/*.html\"",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm run test",
    "test": "node --test \"tests/**/*.test.js\"",
    "audit": "node scripts/audit.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:articles": "node scripts/build-articles.mjs",
    "build:products": "node scripts/build-products.mjs",
    "build:vocabulary": "node scripts/build-vocabulary.mjs",
    "build": "npm run build:articles && npm run build:products && npm run build:vocabulary",
    "backup:d1": "node scripts/backup-d1.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "backup:prune": "node scripts/prune-backups.mjs",
    "backup:restore-drill": "node scripts/restore-drill.mjs",
    "d1:remote": "node scripts/d1-remote.mjs",
    "inquiries": "node scripts/inquiries.mjs",
    "articles:import": "node scripts/import-articles.mjs",
    "vocab:stats": "node scripts/vocab-stats.mjs",
    "vocab:check": "node scripts/vocab-check.mjs",
    "vocab:review": "node scripts/vocab-review.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "html-validate": "^11.16.1",
    "marked": "^18.0.14",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "wrangler": "^4.146.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
